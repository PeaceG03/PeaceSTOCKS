{
  "name": "@peacestocks/markets-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone PeaceSTOCKS markets scanner, migrated from PeaceAI packages/markets-scanner.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scanner": "tsc -p tsconfig.scanner.json --noEmit",
    "typecheck:lib": "tsc -p tsconfig.lib.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "scheduler": "tsx src/host.ts",
    "backfill": "tsx src/backfill-job-cli.ts",
    "research": "tsx src/research-harness-cli.ts",
    "backfill:dry-run": "tsx src/backfill-dry-run-cli.ts",
    "scan:reliability": "tsx src/scan-reliability-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
